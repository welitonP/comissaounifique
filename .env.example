# Banco de dados PostgreSQL (ex: Supabase). No Supabase, pegue as duas strings em
# Project Settings > Database > Connection string.
# DATABASE_URL: connection pooling (porta 6543, ?pgbouncer=true) - usada em runtime.
# DIRECT_URL: conexão direta (porta 5432) - usada apenas para migrations (db push).
DATABASE_URL="postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

AUTH_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"

# IA - Claude (Anthropic), provedor principal. Cole a chave que a empresa forneceu.
# Opcional: ANTHROPIC_MODEL (padrão claude-haiku-4-5, econômico; troque para
# claude-sonnet-5 ou claude-opus-5 se quiser mais capricho) e ANTHROPIC_BASE_URL
# (só se a empresa usar um gateway próprio no lugar de api.anthropic.com).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# IA - Gemini (Google AI Studio, plano gratuito). Funciona como reserva automática
# caso o Claude fique indisponível. Se nenhuma das duas estiver preenchida, o
# assistente fica desativado. Pegue em https://aistudio.google.com/apikey .
GEMINI_API_KEY=""
