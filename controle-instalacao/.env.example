# Postgres (Supabase, Neon ou qualquer outro).
# DATABASE_URL usa a porta pooled (6543); DIRECT_URL a direta (5432),
# necessária para o "prisma db push" e as migrações.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Assina o cookie de sessão. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-ou-mais-caracteres"

# Usados só pelo "npm run db:seed" para criar o primeiro administrador.
SEED_ADMIN_USER="admin"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD=""
