generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Um evento = uma instalação (Expo, feira, festa, rodeio...).
/// Tudo o que é controlado pende deste registro, então criar o próximo
/// evento é só criar outra linha aqui — opcionalmente clonando um anterior.
model Event {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  city      String?
  address   String?
  startsAt  DateTime?
  endsAt    DateTime?
  notes     String?
  archived  Boolean  @default(false)

  /// Planta do local. Guardada no banco para o deploy continuar sem disco.
  planImage     Bytes?
  planMimeType  String?
  planWidth     Int?
  planHeight    Int?
  /// Versão original (sem tratamento), exibida no botão "ver original".
  planOriginal         Bytes?
  planOriginalMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  points     MapPoint[]
  equipments Equipment[]
  cables     Cable[]
  changes    ChangeLog[]

  @@index([archived, createdAt])
}

enum PointStatus {
  PENDING /// Cabo ainda não passado
  CABLED  /// Cabo passado, aguardando ativação
  ACTIVE  /// AP instalado e em operação
}

enum EquipmentStatus {
  PLANNED   /// Planejado
  INSTALLED /// Instalado
  ONLINE    /// Em operação
}

enum CableStatus {
  PLANNED /// Planejado
  LAID    /// Passado
  TESTED  /// Testado
}

/// Ponto de acesso (AP) posicionado sobre a planta.
model MapPoint {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  number Int
  name   String
  sector String?
  status PointStatus @default(PENDING)

  /// Posição em porcentagem da planta (0–100), para o marcador acompanhar
  /// qualquer resolução de imagem e qualquer nível de zoom.
  x Float
  y Float
  /// Falso enquanto a posição herdada/importada ainda não foi conferida em campo.
  positionChecked Boolean @default(false)

  owner String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cablesFrom Cable[] @relation("CableToPoint")

  @@unique([eventId, number])
  @@index([eventId, status])
}

/// Equipamento principal (switch, RB, ONU) que alimenta um setor.
model Equipment {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  number Int
  name   String
  sector String?
  kind   String?
  status EquipmentStatus @default(PLANNED)

  x Float
  y Float
  positionChecked Boolean @default(false)

  owner String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cables Cable[] @relation("CableFromEquipment")

  @@unique([eventId, number])
  @@index([eventId, status])
}

/// Trajeto de cabo entre um equipamento e um ponto, com os desvios
/// desenhados sobre a planta.
model Cable {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  number Int
  label  String?
  kind   String?
  status CableStatus @default(PLANNED)

  fromEquipmentId String?
  fromEquipment   Equipment? @relation("CableFromEquipment", fields: [fromEquipmentId], references: [id], onDelete: SetNull)
  toPointId       String?
  toPoint         MapPoint?  @relation("CableToPoint", fields: [toPointId], references: [id], onDelete: SetNull)

  /// Vértices do trajeto: [{x,y}, ...] em porcentagem da planta.
  waypoints Json @default("[]")

  lengthMeters Float?
  owner String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, number])
  @@index([eventId, status])
}

/// Trilha de auditoria. Guarda o estado anterior para permitir desfazer.
model ChangeLog {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  entity   String /// "point" | "equipment" | "cable"
  entityId String
  action   String /// "create" | "update" | "delete"
  summary  String
  author   String?

  /// Snapshot anterior, usado pelo "Desfazer".
  before Json?
  after  Json?
  undone Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

/// Acesso ao painel. Senha guardada como hash scrypt.
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  name         String
  passwordHash String
  role         String  @default("member") /// "admin" | "member"
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
