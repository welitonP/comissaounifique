generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Configuração da barbearia. É sempre uma linha só (id fixo "config").
model Barbearia {
  id                 String   @id @default("config")
  nome               String
  slogan             String?
  telefone           String?
  whatsapp           String?
  endereco           String?
  instagram          String?
  mapsUrl            String?
  // De quanto em quanto tempo os horários são oferecidos (15 = 09:00, 09:15...).
  passoMin           Int      @default(15)
  // Antecedência mínima para o cliente agendar pelo site (em minutos).
  antecedenciaMin    Int      @default(60)
  // Até quantos dias à frente a agenda fica aberta.
  diasMax            Int      @default(21)
  // Até quantas horas antes o cliente ainda pode cancelar sozinho.
  limiteCancelamentoH Int     @default(2)
  atualizadoEm       DateTime @updatedAt @default(now())
}

// Quem entra na área ADM. "dono" vê tudo; "barbeiro" vê a agenda dele.
model Usuario {
  id             String        @id @default(cuid())
  nome           String
  usuario        String        @unique
  senhaHash      String
  papel          String        @default("dono")
  ativo          Boolean       @default(true)
  profissionalId String?       @unique
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  criadoEm       DateTime      @default(now())
}

model Profissional {
  id           String                @id @default(cuid())
  nome         String
  apelido      String?
  bio          String?
  fotoUrl      String?
  ativo        Boolean               @default(true)
  ordem        Int                   @default(0)
  criadoEm     DateTime              @default(now())
  usuario      Usuario?
  servicos     ServicoProfissional[]
  horarios     HorarioTrabalho[]
  bloqueios    Bloqueio[]
  agendamentos Agendamento[]
}

model Servico {
  id            String                @id @default(cuid())
  nome          String
  descricao     String?
  precoCentavos Int
  duracaoMin    Int
  ativo         Boolean               @default(true)
  destaque      Boolean               @default(false)
  ordem         Int                   @default(0)
  criadoEm      DateTime              @default(now())
  profissionais ServicoProfissional[]
  agendamentos  Agendamento[]
}

// Quais serviços cada profissional atende.
model ServicoProfissional {
  servicoId      String
  servico        Servico      @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@id([servicoId, profissionalId])
}

// Expediente semanal fixo de cada profissional (horário de Brasília).
model HorarioTrabalho {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  diaSemana      Int // 0 = domingo ... 6 = sábado
  inicio         String // "09:00"
  fim            String // "19:00"
  pausaInicio    String? // almoço, opcional
  pausaFim       String?

  @@unique([profissionalId, diaSemana])
}

// Folga, feriado ou compromisso. Sem profissionalId = barbearia fechada.
model Bloqueio {
  id             String        @id @default(cuid())
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  inicio         DateTime
  fim            DateTime
  motivo         String?
  criadoEm       DateTime      @default(now())

  @@index([inicio, fim])
}

model Cliente {
  id           String        @id @default(cuid())
  nome         String
  telefone     String        @unique // só dígitos, ex: "47999998888"
  observacao   String?
  criadoEm     DateTime      @default(now())
  agendamentos Agendamento[]
}

model Agendamento {
  id             String       @id @default(cuid())
  // Código público do comprovante: o cliente acessa /agendamento/<token>.
  token          String       @unique @default(cuid())
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  servicoId      String
  servico        Servico      @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  inicio         DateTime
  fim            DateTime
  status         String       @default("agendado") // agendado | concluido | cancelado | faltou
  precoCentavos  Int // congelado no momento do agendamento
  origem         String       @default("site") // site | balcao
  observacao     String?
  criadoEm       DateTime     @default(now())

  @@index([profissionalId, inicio])
  @@index([inicio])
}
