# Banco de dados PostgreSQL (ex: Supabase, plano gratuito).
# No Supabase: Project Settings > Database > Connection string.
# DATABASE_URL: connection pooling (porta 6543, ?pgbouncer=true) - usada em runtime.
# DIRECT_URL: conexão direta (porta 5432) - usada só nas migrations (db push).
DATABASE_URL="postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo que assina o cookie de login da área ADM.
# Gere uma string longa e aleatória: openssl rand -hex 32
AUTH_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"

# Usuário e senha do primeiro acesso, criados pelo "npm run db:seed".
# Depois de entrar, troque a senha em ADM > Minha conta.
ADMIN_USUARIO="dono"
ADMIN_SENHA="barbearia123"
